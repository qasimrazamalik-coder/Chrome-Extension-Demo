{
  "manifest_version": 3,
  "name": "AI Job Application Copilot",
  "version": "1.0.0",
  "description": "Tailor job applications with AI directly from your browser.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "AI Job Copilot"
  },
  "options_page": "index.html?view=dashboard",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.glassdoor.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
